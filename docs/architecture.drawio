      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="kurofukubo — システム構成図 (AWS / サーバーレス)" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="28" y="16" width="640" height="26" as="geometry" />
        </mxCell>

        <!-- AWS Cloud frame -->
        <mxCell id="aws" value="AWS Cloud — prod (117953360790) ／ ap-northeast-1（CloudFront・Route 53=グローバル, ACM=us-east-1）" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;container=0;pointerEvents=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
