<mxfile host="app.diagrams.net" type="device">
  <diagram id="kurofukubo-arch" name="システム構成図">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- prod account boundary -->
        <mxCell id="acct" value="AWS prod アカウント (117953360790) / ap-northeast-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="940" height="640" as="geometry" />
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="ユーザー&#10;(ブラウザ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Route53 -->
        <mxCell id="r53" value="Route 53&#10;app.kurofukubo.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- ACM -->
        <mxCell id="acm" value="ACM (us-east-1)&#10;TLS証明書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="500" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cf" value="CloudFront&#10;(OAC / SPAフォールバック)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="S3 (非公開)&#10;React SPA (Vite)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="API Gateway&#10;(REST, stage=prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Cognito -->
        <mxCell id="cognito" value="Cognito User Pool&#10;Authorizer (JWT検証)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Lambda -->
        <mxCell id="lambda" value="Lambda (Node.js 20, arm64)&#10;journals / accounts / settings / postConfirm&#10;OPTIONS=CORS(env ALLOWED_ORIGIN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="290" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- DynamoDB -->
        <mxCell id="ddb" value="DynamoDB&#10;シングルテーブル + GSI1&#10;PK=USER#&lt;userId&gt; (テナント分離)&#10;PITR有効" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="280" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- CloudWatch -->
        <mxCell id="cw" value="CloudWatch Alarms&#10;Lambda err / API 5xx / DDB throttle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="470" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- SNS -->
        <mxCell id="sns" value="SNS&#10;kakeibo-alarms-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="470" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Email -->
        <mxCell id="mail" value="メール通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="600" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_user_cf" value="HTTPS (静的)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_user_api" value="fetch /api (Bearer JWT)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="user" target="apigw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r53_cf" value="Alias" style="endArrow=block;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="r53" target="cf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_acm_cf" value="証明書" style="endArrow=block;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="acm" target="cf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cf_s3" value="OAC" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_api_cog" value="検証" style="endArrow=block;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="apigw" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_api_lambda" value="invoke" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="apigw" target="lambda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_lambda_ddb" value="CRUD" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="lambda" target="ddb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_lambda_cw" value="logs/metrics" style="endArrow=block;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="lambda" target="cw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cw_sns" value="アラーム" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="cw" target="sns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sns_mail" value="" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="sns" target="mail"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
