        <mxCell id="legend" value="凡例：&lt;b style=&quot;color:#2D6CDF&quot;&gt;青=外部通信&lt;/b&gt; ／ &lt;b style=&quot;color:#8C4FFF&quot;&gt;紫=DB&lt;/b&gt; ／ 破線=認証・補助・非同期&#10;①〜⑤=リクエストの流れ ／ ゲスト = localStorage のみ（サーバー通信なし）" style="text;html=1;fontSize=10;fontColor=#5d6b6a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="320" height="40" as="geometry" />
