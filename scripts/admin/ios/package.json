{
  "name": "kurofukubo-admin-ios",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "bundle-ui": "node bundle-ui.mjs",
    "export": "npm run bundle-ui && expo export --platform ios",
